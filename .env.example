# ==============================================================================
# BLUEPRINT — Environment Configuration
# Copy this file to .env.local (local dev) and set the same values as
# Environment Variables in your Vercel project (Project Settings → Environment
# Variables). Nothing in the codebase is hardcoded — everything reads from
# these variables, so moving from Vercel to your own VPS later is just a
# matter of setting the same variables in the new environment.
# ==============================================================================

# --- Supabase (source of truth for auth + database) --------------------------
# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER SIDE ONLY. Never expose to the browser.
# Required by scripts/create-user.ts and any privileged server-side action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string — used only by scripts/run-migrations.ts
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- AI Provider ---------------------------------------------------------------
# The provider layer (lib/ai/provider.ts) is written so you can add another
# provider file under lib/ai/providers/ and switch AI_PROVIDER without
# touching any application code.
AI_PROVIDER=kimi

# Kimi (Moonshot AI) — OpenAI-compatible Chat Completions API
KIMI_API_KEY=your-kimi-api-key
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-32k

# --- App -----------------------------------------------------------------------
# Public URL of the deployed app (used in generated follow-up drafts, emails, etc.)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Name shown in the UI — internal branding only, change any time
NEXT_PUBLIC_APP_NAME=Blueprint
